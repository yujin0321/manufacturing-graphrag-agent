_:cb185bfc6ffaa6fdd5e5696c32dfeb9a4eb626e6a2b00aeeb19f210c7f77549ce7 <http://www.w3.org/ns/shacl#select> "\n            PREFIX im: <https://example.org/imaks/v1#>\n            SELECT $this WHERE {\n                $this im:critLo ?critLo ; im:warnLo ?warnLo ; im:nominal ?nominal ; im:warnHi ?warnHi ; im:critHi ?critHi .\n                FILTER (!(?critLo < ?warnLo && ?warnLo < ?nominal && ?nominal < ?warnHi && ?warnHi < ?critHi))\n            }\n        " .
