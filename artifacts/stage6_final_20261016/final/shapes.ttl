        [ sh:hasValue "ST02_SEALING_TMP >210°C (CRITICAL): emergency stop ST04_PACKAGING." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:conditionText ],
        [ sh:hasValue "emergency_stop" ;
