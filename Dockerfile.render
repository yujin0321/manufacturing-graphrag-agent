
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    IMAKS_BIND_HOST=0.0.0.0

WORKDIR /app

COPY docs/agent_handoff/requirements.txt /tmp/requirements.txt

RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --create-home --uid 1000 imaks

COPY --chown=imaks:imaks . /app

RUN mkdir -p /app/kg_build /app/preprocessed /app/reports \
    && chown -R imaks:imaks /app

USER imaks

EXPOSE 8770

CMD ["python", "scripts/render_start.py"]

