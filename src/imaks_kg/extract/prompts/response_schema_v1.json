{
  "type": "object",
  "additionalProperties": false,
  "required": ["rules", "coverage"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "printed_rule_id", "condition", "action", "ruleSeverity", "sensors", "action_targets", "evidence"],
        "properties": {
          "class": {"type": "string", "enum": ["OperationalRule", "ThresholdRule", "MaintenanceRule", "AccessRule"]},
          "printed_rule_id": {"type": ["string", "null"]},
          "condition": {"type": "string"},
          "action": {"type": "string"},
          "ruleSeverity": {"type": "string"},
          "sensors": {"type": "array", "items": {"type": "string"}},
          "action_targets": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chunk_id", "source_quote", "supports", "table_row", "table_col"],
              "properties": {
                "chunk_id": {"type": "string"},
                "source_quote": {"type": "string"},
                "supports": {
                  "type": "array",
                  "items": {"type": "string", "enum": ["condition", "action", "ruleSeverity", "sensors", "action_targets", "printed_rule_id", "class"]}
                },
                "table_row": {"type": ["integer", "null"], "minimum": 1},
                "table_col": {"type": ["integer", "null"], "minimum": 1}
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "coverage_status", "rules", "reason"],
        "properties": {
          "chunk_id": {"type": "string"},
          "coverage_status": {"type": "string", "enum": ["included", "excluded"]},
          "rules": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "reason": {"type": ["string", "null"], "enum": ["heading", "boilerplate", "duplicate", "not_a_rule", null]}
        }
      }
    }
  }
}
