@prefix im: <https://example.org/imaks/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/ANOMALY-CORRELATED> a im:Rule,
        im:ThresholdRule ;
    im:conditionText "Causally linked to another station; Onset within 90 min of cause"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/787>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/788>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/789>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/790>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/791>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/792>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/793>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/794> ;
    im:identifier "ANOMALY-CORRELATED"^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/SOP-002> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/ANOMALY-DRIFT> a im:Rule,
        im:ThresholdRule ;
    im:conditionText "Monotonic deviation >15 min; Slope >0.1σ/min for 5+ readings"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/763>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/764>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/765>,
