rc:Review-REL-07 a sh:NodeShape ;
    sh:property [ sh:hasValue "AI" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:reviewerType ],
        [ sh:hasValue "retain_as_document_claim_only" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:decision ] ;
    sh:targetNode rc:review-REL-07-20261016 .

rc:EvidenceShape a sh:NodeShape ;
    sh:property [ sh:class im:Document ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:sourceDocument ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path rc:sourceQuote ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path rc:sourceUnit ],
        [ sh:minCount 1 ;
            sh:path rc:sourceFileSha256 ;
            sh:pattern "^[a-f0-9]{64}$" ],
        [ sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path rc:page ] .

