inst:candidate-DS-ELEC-3300%3A%3ADS-ELEC-3300-EX-01 a im:OperationalRule ;
    im:conditionText "Series 3300 sensor current is between 14 A and 20 A." ;
    im:extractionMethod "llm:gpt-6.1-sol" ;
    im:hasProvenance inst:prov-28668c0cc378dd446360 ;
    im:identifier "candidate-DS-ELEC-3300::DS-ELEC-3300-EX-01" ;
    im:responseText "Limit operation in this range to short durations (< 60 seconds). Sustained operation above 14 A causes progressive accuracy drift." ;
    im:sourceDocument inst:DS-ELEC-3300 .

inst:candidate-DS-ELEC-3300%3A%3ADS-ELEC-3300-EX-02 a im:OperationalRule ;
    im:conditionText "Setting process current alarm thresholds that trigger corrective action for the Series 3300 sensor." ;
    im:extractionMethod "llm:gpt-6.1-sol" ;
    im:hasProvenance inst:prov-974276b1bf939f355472 ;
    im:identifier "candidate-DS-ELEC-3300::DS-ELEC-3300-EX-02" ;
    im:responseText "ElectroMeasure recommends setting these thresholds no higher than the continuous overload rating of 14 A." ;
    im:sourceDocument inst:DS-ELEC-3300 .

inst:candidate-DS-MECH-4400%3A%3ADS-MECH-4400-EX-01 a im:OperationalRule ;
    im:conditionText "When setting alarm thresholds for the PRS-4410 pressure transmitter with total accuracy of ±0.10 bar." ;
    im:extractionMethod "llm:gpt-6.1-sol" ;
    im:hasProvenance inst:prov-859f56159fc21b040144 ;
    im:identifier "candidate-DS-MECH-4400::DS-MECH-4400-EX-01" ;
    im:responseText "Set alarm thresholds at least 5× the accuracy (0.50 bar) from the nominal operating point to avoid nuisance alarms. Thresholds closer than 3× accuracy (0.30 bar) are not recommended for process control." ;
    im:sourceDocument inst:DS-MECH-4400 .

inst:candidate-DS-THERM-2200%3A%3ADS-THERM-2200-EX-01 a im:OperationalRule ;
    im:conditionText "TMP-2210 intermittent temperature exposure, with a maximum of 220°C." ;
    im:extractionMethod "llm:gpt-6.1-sol" ;
    im:hasProvenance inst:prov-6b6bbfbc424202fbf10e ;
    im:identifier "candidate-DS-THERM-2200::DS-THERM-2200-EX-01" ;
    im:responseText "Limit exposure to < 10 min; do not use this intermittent rating for control." ;
    im:sourceDocument inst:DS-THERM-2200 .

inst:candidate-DS-THERM-2200%3A%3ADS-THERM-2200-EX-02 a im:OperationalRule ;
    im:conditionText "An application requires sustained temperature operation above the TMP-2210 continuous maximum of 200°C." ;
    im:extractionMethod "llm:gpt-6.1-sol" ;
    im:hasProvenance inst:prov-3c577fbbc4bb1346a0a8 ;
    im:identifier "candidate-DS-THERM-2200::DS-THERM-2200-EX-02" ;
    im:responseText "ThermoSense recommends the Series 2400 (Pt100 RTD, rated to 250°C continuous). Exposure above 200°C accelerates thermocouple ageing and may cause drift of up to ±5°C within 500 hours." ;
    im:sourceDocument inst:DS-THERM-2200 .

