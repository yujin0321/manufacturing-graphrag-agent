    im:identifier "candidate-SOP-003::SOP-003-EX-02" ;
    im:responseText "1. Reduce SRV01_SERVERROOM temperature to <25°C. 2. Verify PLC heartbeats. 3. Clear STUCK alarms." ;
    im:sourceDocument inst:SOP-003 .

