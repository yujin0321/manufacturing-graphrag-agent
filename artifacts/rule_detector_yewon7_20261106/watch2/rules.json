{"policy":{"duration":"strict elapsed seconds > limit","gap_reset":true,"split_reset":false,"warning_samples":2},"rules":[{"condition_text":"CAF01_CAFETERIA temperature (TMP) is above 26°C; occupant comfort is the primary criterion.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CAF01-01","kind":"kg_document_rule","op":"gt","rule_id":"RULE-CAF01-01","second":null,"sensor_id":"CAF01_CAFETERIA_TMP","unit":"°C","value":"26"},{"condition_text":"CAF01_CAFETERIA humidity (HUM) is above 70%RH.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CAF01-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-CAF01-02","second":null,"sensor_id":"CAF01_CAFETERIA_HUM","unit":"%RH","value":"70"},{"condition_text":"CHM01_CHEMICALSTORAGE temperature (TMP) must remain between 10°C and 20°C.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CHM01-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-CHM01-01","second":"20","sensor_id":"CHM01_CHEMICALSTORAGE_TMP","unit":"°C","value":"10"},{"condition_text":"CHM01_CHEMICALSTORAGE temperature (TMP) is above 25°C (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CHM01-01-CRITICAL","kind":"kg_document_rule","op":"gt","rule_id":"RULE-CHM01-01-CRITICAL","second":null,"sensor_id":"CHM01_CHEMICALSTORAGE_TMP","unit":"°C","value":"25"},{"condition_text":"CHM01_CHEMICALSTORAGE humidity (HUM) must not exceed 50%RH; elevated humidity accelerates degradation of hygroscopic reagents.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CHM01-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-CHM01-02","second":null,"sensor_id":"CHM01_CHEMICALSTORAGE_HUM","unit":"%RH","value":"50"},{"condition_text":"CHM01_CHEMICALSTORAGE humidity (HUM) >45%RH.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-CHM01-02-DESICCANT","kind":"kg_document_rule","op":"gt","rule_id":"RULE-CHM01-02-DESICCANT","second":null,"sensor_id":"CHM01_CHEMICALSTORAGE_HUM","unit":"%RH","value":"45"},{"condition_text":"RND01_RDLAB temperature (TMP) must remain between 18°C and 26°C for experimental validity.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-RND01-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-RND01-01","second":"26","sensor_id":"RND01_RDLAB_TMP","unit":"°C","value":"18"},{"condition_text":"RND01_RDLAB humidity (HUM) drifts above 65%RH.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-RND01-02","kind":"kg_document_rule","note":"drift wording executed as absolute threshold (v1 decision)","op":"gt","rule_id":"RULE-RND01-02","second":null,"sensor_id":"RND01_RDLAB_HUM","unit":"%RH","value":"65"},{"condition_text":"RND01_RDLAB humidity (HUM) is above 75%RH (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-RND01-02-CRITICAL","kind":"kg_document_rule","op":"gt","rule_id":"RULE-RND01-02-CRITICAL","second":null,"sensor_id":"RND01_RDLAB_HUM","unit":"%RH","value":"75"},{"condition_text":"SRV01_SERVERROOM temperature (TMP) must not exceed 25°C.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-SRV01-01","kind":"kg_document_rule","op":"gt","rule_id":"RULE-SRV01-01","second":null,"sensor_id":"SRV01_SERVERROOM_TMP","unit":"°C","value":"25"},{"condition_text":"SRV01_SERVERROOM temperature (TMP) > 28°C (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-SRV01-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-SRV01-02","second":null,"sensor_id":"SRV01_SERVERROOM_TMP","unit":"°C","value":"28"},{"condition_text":"ST01_FILLING flow (FLW) must be maintained between 112 and 128 L/min.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST01-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-ST01-01","second":"128","sensor_id":"ST01_FILLING_FLW","unit":"L/min","value":"112"},{"condition_text":"ST01_FILLING temperature (TMP) exceeds 26°C.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST01-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-ST01-02","second":null,"sensor_id":"ST01_FILLING_TMP","unit":"°C","value":"26"},{"condition_text":"ST01_FILLING pressure (PRS) drops below 3.3 bar.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST01-03","kind":"kg_document_rule","op":"lt","rule_id":"RULE-ST01-03","second":null,"sensor_id":"ST01_FILLING_PRS","unit":"bar","value":"3.3"},{"condition_text":"ST02_SEALING temperature (TMP) must remain between 175°C and 195°C.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST02-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-ST02-01","second":"195","sensor_id":"ST02_SEALING_TMP","unit":"°C","value":"175"},{"condition_text":"ST02_SEALING temperature (TMP) > 210°C (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST02-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-ST02-02","second":null,"sensor_id":"ST02_SEALING_TMP","unit":"°C","value":"210"},{"condition_text":"ST02_SEALING current (CUR) increases >1.5 A above nominal, sustained >5 min.","duration_seconds":300,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST02-03","kind":"kg_document_rule","op":"gt","rule_id":"RULE-ST02-03","second":null,"sensor_id":"ST02_SEALING_CUR","unit":"A","value":"13.9"},{"condition_text":"ST03_LABELLING tension (TEN) must be between 1.8 and 2.6 N.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST03-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-ST03-01","second":"2.6","sensor_id":"ST03_LABELLING_TEN","unit":"N","value":"1.8"},{"condition_text":"ST03_LABELLING count rate (CNT) is below 110 pcs/min.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST03-02","kind":"kg_document_rule","op":"lt","rule_id":"RULE-ST03-02","second":null,"sensor_id":"ST03_LABELLING_CNT","unit":"pcs/min","value":"110"},{"condition_text":"ST03_LABELLING count rate (CNT) is below 100 pcs/min (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST03-02-CRITICAL","kind":"kg_document_rule","op":"lt","rule_id":"RULE-ST03-02-CRITICAL","second":null,"sensor_id":"ST03_LABELLING_CNT","unit":"pcs/min","value":"100"},{"condition_text":"ST03_LABELLING tension (TEN) is STUCK for >10 consecutive samples, indicating sensor failure.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST03-03","kind":"kg_document_rule","op":"stuck_exact","rule_id":"RULE-ST03-03","second":null,"sensor_id":"ST03_LABELLING_TEN","unit":"N","value":"11"},{"condition_text":"ST04_PACKAGING vibration (VIB) > 0.20 mm/s (WARNING).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST04-01","kind":"kg_document_rule","op":"gt","rule_id":"RULE-ST04-01","second":null,"sensor_id":"ST04_PACKAGING_VIB","unit":"mm/s","value":"0.20"},{"condition_text":"ST04_PACKAGING vibration (VIB) > 0.35 mm/s (CRITICAL).","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-ST04-02","kind":"kg_document_rule","op":"gt","rule_id":"RULE-ST04-02","second":null,"sensor_id":"ST04_PACKAGING_VIB","unit":"mm/s","value":"0.35"},{"condition_text":"WRH01_WAREHOUSE temperature (TMP) must remain between 0.5°C and 8°C.","duration_seconds":0,"kg_node":"https://example.org/imaks/id/candidate-SOP-001%3A%3ARULE-WRH01-01","kind":"kg_document_rule","op":"outside","rule_id":"RULE-WRH01-01","second":"8","sensor_id":"WRH01_WAREHOUSE_TMP","unit":"°C","value":"0.5"},{"condi