        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/768>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/769>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/770> ;
    im:identifier "ANOMALY-DRIFT"^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/SOP-002> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/ANOMALY-OUT_OF_RANGE> a im:Rule,
        im:ThresholdRule ;
    im:conditionText "Sustained WARN violation >10 min; >WARN for 20+ readings"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/779>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/780>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/781>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/782>,
