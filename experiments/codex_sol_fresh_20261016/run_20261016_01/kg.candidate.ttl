        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/784>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/785>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/786> ;
    im:identifier "ANOMALY-OUT_OF_RANGE"^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/SOP-002> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/ANOMALY-SPIKE> a im:Rule,
        im:ThresholdRule ;
    im:conditionText "Transient deviation >3σ, <5 min; Single reading >CRIT"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/755>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/756>,
