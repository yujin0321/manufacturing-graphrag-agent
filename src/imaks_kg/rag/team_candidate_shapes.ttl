@prefix det: <https://example.org/imaks/detection/engine#> .
@prefix im: <https://example.org/imaks/v1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Unclassified scanner outputs are candidates, not AnomalyEvent instances.
# Core ontology S2 is kept unchanged. No anomaly subtype is inferred here.
det:RuleMatchCandidateShape a sh:NodeShape ;
    sh:targetClass det:RuleMatchCandidate ;
    sh:not [ sh:class im:AnomalyEvent ] ;
    sh:property [ sh:path det:observedOnSensor ; sh:class im:Sensor ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path det:matchedRule ; sh:class im:Rule ; sh:minCount 1 ] ;
    sh:property [ sh:path det:sourceWindow ; sh:class im:Provenance ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path det:engineIncidentId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path det:triggeredAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path det:lastPositiveAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .
