<https://example.org/imaks/id/rule/RULE-ST02-02> a im:Rule ;
    im:actionTarget inst:N0013,
        inst:N0017,
        inst:N0021 ;
    im:appliesToSensor inst:N0014 ;
    im:conditionText "TMP > 210°C (CRITICAL)" ;
    im:extractionMethod "manual source-grounded example; not LLM extraction" ;
    im:identifier "RULE-ST02-02" ;
    im:responseText "emergency stop ST02, ST03, ST04." ;
    im:sourceDocument <https://example.org/imaks/id/document/SOP-001> ;
    im:sourcePage "1"^^xsd:positiveInteger ;
    im:sourceQuote "RULE-ST02-02: TMP > 210°C (CRITICAL) — emergency stop ST02, ST03, ST04." .

<https://example.org/imaks/id/rule/RULE-ST02-04> a im:Rule ;
    im:appliesToSensor inst:N0016 ;
    im:conditionText "CUR drift at ST02_SEALING; CUR triggers a WARNING" ;
    im:extractionMethod "manual source-grounded example; not LLM extraction" ;
    im:identifier "RULE-ST02-04" ;
    im:monitorsSensor inst:N0024 ;
    im:responseText "Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers a WARNING." ;
    im:sourceDocument <https://example.org/imaks/id/document/SOP-001> ;
    im:sourcePage "1"^^xsd:positiveInteger ;
    im:sourceQuote """RULE-ST02-04: CUR drift at ST02_SEALING CORRELATES with speed reduction at ST04_PACKAGING due to
shared electrical coupling. Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers a
WARNING.""" .

<https://example.org/imaks/id/rule/SOP002-THRESHOLD-CAF01_CAFETERIA_HUM> a im:Rule,
        im:ThresholdRule ;
    im:appliesToSensor inst:N0039 ;
    im:conditionText "CRIT_LO < WARN_LO < NOMINAL < WARN_HI < CRIT_HI; CRITICAL response applies outside critical bounds." ;
    im:critHi 8e+01 ;
    im:critLo 2.5e+01 ;
    im:extractionMethod "deterministic SOP-002 corrected table mapping; not LLM extraction" ;
    im:identifier "SOP002-THRESHOLD-CAF01_CAFETERIA_HUM" ;
    im:nominal 5.5e+01 ;
    im:nominalText "55.0 ± 1.5" ;
    im:nominalTolerance 1.5e+00 ;
    im:responseText "Inspect and notify maintenance" ;
    im:sourceDocument <https://example.org/imaks/id/document/SOP-002> ;
    im:sourcePage "2"^^xsd:positiveInteger ;
    im:sourceQuote "[\"HUM\", \"%RH\", \"25.0\", \"35.0\", \"55.0 ± 1.5\", \"70.0\", \"80.0\", \"Inspect and notify maintenance\"]" ;
