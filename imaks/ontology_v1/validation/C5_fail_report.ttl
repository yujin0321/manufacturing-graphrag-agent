_:cb1899ee40a2e51e3bfd32c731fb68c642f946d06ff1002a9d5fbe3a84a5ac3971 <http://www.w3.org/ns/shacl#value> "GT-0007" .
_:cb44a6af01cdf678c8655a53214912814370c315701978ff14b09971298657814b <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
_:cb44a6af01cdf678c8655a53214912814370c315701978ff14b09971298657814b <http://www.w3.org/ns/shacl#message> "C5 입력 그래프에 금지 라벨·알람·정답·시간 라벨 predicate가 있습니다."@ko .
_:cb44a6af01cdf678c8655a53214912814370c315701978ff14b09971298657814b <http://www.w3.org/ns/shacl#select> "\n            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT $this ?path ?value WHERE {\n                ?subject ?path ?value .\n                BIND(LCASE(REPLACE(REPLACE(STR(?path), \"^.*[/#: ]\", \"\"), \"[_-]\", \"\")) AS ?local)\n                FILTER (?local IN (\"label\", \"quality\", \"status\", \"alarms\", \"gtid\", \"anomalylabel\", \"datasetseverity\", \"severity\", \"alarmflag\", \"shift\", \"day\", \"batchid\"))\n                FILTER (?path != rdfs:label)\n            }\n        " .
