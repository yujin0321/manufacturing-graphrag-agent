  {
    "id": "ISSUE-02",
    "kind": "cross_document_limit",
    "detail": "Thermal datasheet continuous rating 200°C versus ST02 critical high 210°C. Actual installed model unknown; this is a compatibility review candidate, not a proved equipment violation.",
    "evidence": [
      {
        "document_id": "DS-THERM-2200",
        "page": 1,
        "chunk_id": "DS-THERM-2200:p1:text2",
        "table_id": null,
        "row_index": null,
        "col_index": null,
        "bbox": null,
        "char_start": 471,
        "char_end": 857,
        "quote": "Note 1 — Maximum Operating Temperature: The rated maximum for continuous operation is 200°C. Exposure\nabove this value accelerates thermocouple ageing and may cause drift of up to ±5°C within 500 hours. For\napplications requiring sustained operation above 200°C, ThermoSense recommends the Series 2400 (Pt100 RTD,\nrated to 250°C continuous).\n2. Humidity Sensor HUM-2250 — Specifications",
        "text_sha256": "638568c3df566c234058af4fa2e217a889d7112847c417391bce631652c98193",
        "representation": "page.text_normalized"
      },
      {
        "document_id": "SOP-002",
        "page": 1,
        "chunk_id": "SOP-002:p1:table2:chunk",
        "table_id": "SOP-002:p1:table2",
        "row_index": 2,
        "col_index": 7,
        "bbox": [
          328.82,
          334.87,
          368.5,
          362.87
        ],
        "char_start": null,
        "char_end": null,
        "quote": "210.0",
        "text_sha256": "75f0c1dfd1a75d28b7e077c2b47d5520467d7c256caf1a7f9719baef35bc1ef2",
        "representation": "table.cell.text_normalized"
      }
    ]
  },
  {
    "id": "ISSUE-03",
    "kind": "cross_document_limit",
    "detail": "Current datasheet recommends corrective-action alarm threshold no higher than 14 A; ST02 current critical high is 15 A. Actual installed sensor unknown; retain source values without automatic correction.",
    "evidence": [
      {
        "document_id": "DS-ELEC-3300",
        "page": 1,
        "chunk_id": "DS-ELEC-3300:p1:text2",
        "table_id": null,
        "row_index": null,
        "col_index": null,
        "bbox": null,
        "char_start": 433,
        "char_end": 818,
        "quote": "Note 2 — Continuous Overload Rating: The sensor is rated for continuous operation up to 14 A. Operation between\n14 A and 20 A is permissible for short durations (< 60 seconds). Sustained operation above 14 A will cause\nprogressive accuracy drift. ElectroMeasure recommends that process alarm thresholds triggering corrective action be\nset no higher than the continuous overload rating.",
        "text_sha256": "915f07185029b7769f8b9493e1b91e9013bf8ae900d48f0f78e46d6f8d367350",
        "representation": "page.text_normalized"
      },
