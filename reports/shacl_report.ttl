_:N1ce94a575a9f44f094df23a2867fc8b3 sh:class m:Person ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path m:person .

_:N3edb7a458807417a9757c80f84090e4e sh:message "Alarm acknowledgment exceeded SOP-004 role-specific SLA." ;
    sh:select "PREFIX m: <https://example.org/imaks/> SELECT $this WHERE { $this m:ackDelay ?a; m:maxAllowed ?b. FILTER (?a > ?b || ?a < 0) }" .

_:N34a5f56f63854b1e877e7c7dcaf4c0da sh:message "Zone capacity exceeded (SOP-004)." ;
    sh:select "PREFIX m: <https://example.org/imaks/> SELECT $this WHERE { $this m:count ?a; m:capacity ?b. FILTER (?a > ?b) }" .

