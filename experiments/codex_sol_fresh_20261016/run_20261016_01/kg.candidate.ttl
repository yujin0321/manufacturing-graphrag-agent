        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/776>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/777>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/778> ;
    im:identifier "ANOMALY-STUCK"^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/SOP-002> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/DS-ELEC-3300-p1-ALARM> a im:Rule,
        im:ThresholdRule ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/1088> ;
    im:identifier "DS-ELEC-3300-p1-ALARM"^^xsd:string ;
    im:responseText """ElectroMeasure recommends that process alarm thresholds triggering corrective action be
set no higher than the continuous overload rating."""^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/DS-ELEC-3300> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/DS-ELEC-3300-p1-OVERLOAD> a im:OperationalRule,
        im:Rule ;
    im:conditionText """Operation between
14 A and 20 A"""^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/1087> ;
    im:identifier "DS-ELEC-3300-p1-OVERLOAD"^^xsd:string ;
    im:responseText "permissible for short durations (< 60 seconds)."^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/DS-ELEC-3300> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/DS-MECH-4400-p1-ALARM> a im:Rule,
        im:ThresholdRule ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/1089> ;
    im:identifier "DS-MECH-4400-p1-ALARM"^^xsd:string ;
    im:responseText """Application Note — Alarm Threshold Setting: With a total accuracy of ±0.10 bar, alarm thresholds should be set at
least 5× the accuracy (0.50 bar) from the nominal operating point to avoid nuisance alarms. Thresholds closer than
3× accuracy (0.30 bar) are not recommended for process control."""^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/DS-MECH-4400> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/DS-THERM-2200-p1-SUSTAINED> a im:OperationalRule,
        im:Rule ;
    im:conditionText "applications requiring sustained operation above 200°C"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/1090> ;
    im:identifier "DS-THERM-2200-p1-SUSTAINED"^^xsd:string ;
    im:responseText """ThermoSense recommends the Series 2400 (Pt100 RTD,
rated to 250°C continuous)."""^^xsd:string ;
    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/DS-THERM-2200> .

