rc:Final-REL-07 a sh:NodeShape ;
    sh:property [ sh:hasValue "Thermal fault at sealing: documented downstream speed reduction; not an empirically validated causal link." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:conditionText ],
        [ sh:hasValue <https://example.org/imaks/id/ST02_SEALING> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:subject ],
        [ sh:maxCount 0 ;
            sh:path rc:obligationGroup ],
        [ sh:hasValue "thermal fault" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:triggerDescription ],
        [ sh:hasValue "speed reduction" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:effectDescription ],
        [ sh:hasValue false ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:empiricalCausalityValidated ],
        [ sh:hasValue "pending" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:humanReviewStatus ],
        [ sh:maxCount 0 ;
            sh:path rc:thresholdValue ],
        [ sh:hasValue <https://example.org/imaks/id/ST04_PACKAGING> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:object ],
        [ sh:hasValue "completed" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:aiReviewStatus ],
        [ sh:hasValue rc:documentedThermalEffect ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:relationType ],
        [ sh:hasValue "document_claim" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:assertionScope ],
        [ sh:hasValue rc:review-REL-07-20261016 ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:hasAIReview ],
        [ sh:maxCount 0 ;
            sh:path rc:comparisonOperator ] ;
    sh:targetNode rc:REL-07 .

rc:Review-REL-02 a sh:NodeShape ;
    sh:property [ sh:hasValue "supported_document_instruction" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:decision ],
        [ sh:hasValue "AI" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rc:reviewerType ] ;
    sh:targetNode rc:review-REL-02-20261016 .

rc:Review-REL-03 a sh:NodeShape ;
    sh:property [ sh:hasValue "supported_document_instruction" ;
