_:cbdc93ebba612174a22721ae3622138e74a57f5736adddcf3308ea8f82ac933b07 <http://www.w3.org/ns/shacl#message> "C2 관측 단위가 연결된 센서 단위와 다릅니다."@ko .
_:cbdc93ebba612174a22721ae3622138e74a57f5736adddcf3308ea8f82ac933b07 <http://www.w3.org/ns/shacl#select> "\n            PREFIX im: <https://example.org/imaks/v1#>\n            SELECT $this ?value WHERE {\n                $this im:observedBy ?sensor ; im:unit ?value .\n                ?sensor im:unit ?sensorUnit .\n                FILTER (?value != ?sensorUnit)\n            }\n        " .
