# Copy to the repository root as .env on the server (cp deploy/env.example .env) and fill in.
# .env is git-ignored. Never commit or share it.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=
# Your domain (DNS A record -> server IP). Bare host name only, no https://
IMAKS_PUBLIC_HOSTS=imaks.example.com

# --- Cost protection (strongly recommended for a public URL) ---------------
# Max accepted questions per UTC day for everyone together (0 = unlimited)
IMAKS_GENERATION_DAILY_LIMIT=30
# Max questions per visitor IP per hour (0 = unlimited)
IMAKS_GENERATION_HOURLY_PER_IP=5
# Max CSV/ZIP uploads per visitor IP per hour (0 = unlimited)
IMAKS_UPLOAD_HOURLY_PER_IP=10
# Optional: visitors must enter this code once before asking a question. Leave empty to disable.
IMAKS_ACCESS_CODE=
