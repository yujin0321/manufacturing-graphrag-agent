{
  "type": "object",
  "required": [
    "document_id",
    "class",
    "condition",
    "action",
    "identifier",
    "sensors",
    "equipment",
    "action_targets",
    "evidence",
    "extraction_method",
    "notes"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "class": {
      "enum": [
        "OperationalRule",
        "ThresholdRule",
        "MaintenanceRule",
        "AccessRule"
      ]
    },
    "condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifier": {
      "type": "string"
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "quote",
          "document_id",
          "page",
          "chunk_id",
          "table_id",
          "row_index",
          "col_index",
          "bbox",
          "char_start",
          "char_end",
          "text_sha256"
        ]
      }
    },
    "extraction_method": {
      "type": "string"
    },
    "notes": {
      "type": "array"
    }
  }
}
