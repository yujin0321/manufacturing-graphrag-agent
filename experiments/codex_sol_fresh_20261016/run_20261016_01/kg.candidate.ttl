    im:sourceDocument <https://example.org/imaks/experiment/codex-sol-fresh-20261016/document/SOP-002> .

<https://example.org/imaks/experiment/codex-sol-fresh-20261016/rule/ANOMALY-STUCK> a im:Rule,
        im:ThresholdRule ;
    im:conditionText "Unchanged >10 consecutive readings; std(last 10)<0.001×nominal"^^xsd:string ;
    im:extractionMethod "Codex conversation AI source interpretation + deterministic serialization"^^xsd:string ;
    im:hasProvenance <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/771>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/772>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/773>,
        <https://example.org/imaks/experiment/codex-sol-fresh-20261016/provenance/774>,
