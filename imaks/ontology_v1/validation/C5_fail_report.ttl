_:cb16ad213b0540907c17635e60b1b3d65307ff1b6a3a21aeb1b21238de3279e3b90 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
_:cb16ad213b0540907c17635e60b1b3d65307ff1b6a3a21aeb1b21238de3279e3b90 <http://www.w3.org/ns/shacl#message> "C5 GT-#### 평가 사건 식별자가 입력 그래프에 있습니다."@ko .
_:cb16ad213b0540907c17635e60b1b3d65307ff1b6a3a21aeb1b21238de3279e3b90 <http://www.w3.org/ns/shacl#select> "\n            PREFIX im: <https://example.org/imaks/v1#>\n            SELECT $this ?value WHERE {\n                { ?subject ?predicate ?value .\n                  BIND(LCASE(REPLACE(REPLACE(STR(?predicate), \"^.*[/#: ]\", \"\"), \"[_-]\", \"\")) AS ?local)\n                  FILTER (?local IN (\"identifier\", \"id\", \"nodeid\", \"gtid\"))\n                  FILTER (REGEX(STR(?value), \"^GT-[0-9]{4}$\", \"i\"))\n                }\n                UNION\n                { ?value ?predicate ?object .\n                  FILTER (isIRI(?value) && REGEX(STR(?value), \"[/#: ]GT-[0-9]{4}$\", \"i\"))\n                }\n            }\n        " .
_:cb1899ee40a2e51e3bfd32c731fb68c642f946d06ff1002a9d5fbe3a84a5ac3971 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#ValidationResult> .
